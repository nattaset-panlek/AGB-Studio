{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGB Studio build history (build/report-history.json)",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "at": {
        "type": "string",
        "format": "date-time"
      },
      "romBytes": {
        "type": "integer"
      },
      "seconds": {
        "type": "number"
      },
      "warnings": {
        "type": "integer"
      },
      "errors": {
        "type": "integer"
      },
      "firstError": {
        "type": "string"
      }
    },
    "required": [
      "at",
      "romBytes",
      "seconds",
      "warnings",
      "errors",
      "firstError"
    ]
  }
}
