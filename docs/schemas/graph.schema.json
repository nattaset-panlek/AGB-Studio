{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AGB Studio Logic Graph (scripts/<Name>.graph)",
  "type": "object",
  "properties": {
    "format": {
      "type": "integer"
    },
    "class": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "comments": {
      "type": "array",
      "description": "Comment boxes of the Logic Graph editor",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "w",
          "h"
        ]
      }
    },
    "collapsed": {
      "type": "array",
      "description": "Ids of the nodes drawn collapsed",
      "items": {
        "type": "string"
      }
    },
    "disabled": {
      "type": "object",
      "description": "Nodes and links switched off: a graph of the same shape that the code generator skips",
      "properties": {
        "format": {
          "type": "integer"
        },
        "class": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "props": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "required": [
        "id",
        "type"
      ]
    },
    "link": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ]
    }
  }
}
