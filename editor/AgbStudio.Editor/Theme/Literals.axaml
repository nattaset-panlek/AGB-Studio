<!-- Colours that Figma sets as raw hex instead of a variable (not part of T-K01). Kept here so no XAML or C# file
     outside the Theme folder holds a colour literal (T-L04 scan). They are the same in Dark and Light, as in Figma. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Chip tint fills: Style colour at 16 % -->
  <SolidColorBrush x:Key="lit/chip-accent" Color="#294C8DFF" />
  <SolidColorBrush x:Key="lit/chip-success" Color="#293ECF8E" />
  <SolidColorBrush x:Key="lit/chip-warning" Color="#29FFB020" />
  <SolidColorBrush x:Key="lit/chip-danger" Color="#29FF5D6C" />
  <SolidColorBrush x:Key="lit/chip-script" Color="#29B392FF" />
  <!-- Tooltip background, Switch / Slider knob, Swatch rings and index -->
  <SolidColorBrush x:Key="lit/black" Color="#FF000000" />
  <SolidColorBrush x:Key="lit/white" Color="#FFFFFFFF" />
  <!-- Logic Graph node categories (header fill 18 %, icon 100 %) and pin types -->
  <Color x:Key="lit/node-event">#FF5C7A</Color>
  <Color x:Key="lit/node-input">#3DDC97</Color>
  <Color x:Key="lit/node-physics">#4DA3FF</Color>
  <Color x:Key="lit/node-flow">#A0A3B1</Color>
  <Color x:Key="lit/node-data">#FFC145</Color>
  <Color x:Key="lit/node-sound">#B77CFF</Color>
  <Color x:Key="lit/node-actor">#2EE6D6</Color>
  <Color x:Key="lit/node-math">#FF9F5A</Color>
  <SolidColorBrush x:Key="lit/pin-exec" Color="#E6E7EE" />
  <SolidColorBrush x:Key="lit/pin-bool" Color="#3DDC97" />
  <SolidColorBrush x:Key="lit/pin-fixed" Color="#4DA3FF" />
  <SolidColorBrush x:Key="lit/pin-actor" Color="#2EE6D6" />
  <SolidColorBrush x:Key="lit/pin-text" Color="#FFC145" />
  <!-- Vector pins (Get Velocity, Vector from Velocity): not a Figma pin variant; violet, apart from the other pin colours -->
  <SolidColorBrush x:Key="lit/pin-vector" Color="#B392FF" />
  <SolidColorBrush x:Key="lit/pin-hollow" Color="#202229" />
  <!-- Code colours of the Script Editor, Scripting API example and Generated C# panel (methods use status/success, comments text/muted) -->
  <SolidColorBrush x:Key="lit/code-keyword" Color="#FF7AB6" />
  <SolidColorBrush x:Key="lit/code-type" Color="#7C9CFF" />
  <SolidColorBrush x:Key="lit/code-number" Color="#FFB86B" />
  <!-- Accent colour choices of Preferences · Appearance (T-S06) -->
  <Color x:Key="lit/accent-blue">#4C8DFF</Color>
  <Color x:Key="lit/accent-violet">#B392FF</Color>
  <Color x:Key="lit/accent-green">#3ECF8E</Color>
  <Color x:Key="lit/accent-orange">#FF9F43</Color>
  <Color x:Key="lit/accent-pink">#FF7AB6</Color>
</ResourceDictionary>
