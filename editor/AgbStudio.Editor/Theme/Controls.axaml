<!-- AGB Studio component library (checklist 4.16): control themes built from the Figma section "AGB Studio · Components" -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:AgbStudio.Editor.Controls"
        xmlns:t="using:AgbStudio.Editor.Theme">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AGBStudio/Theme/Literals.axaml" />
        <ResourceInclude Source="avares://AGBStudio/Theme/Chrome.axaml" />
        <ResourceInclude Source="avares://AGBStudio/Theme/Buttons.axaml" />
        <ResourceInclude Source="avares://AGBStudio/Theme/Navigation.axaml" />
        <ResourceInclude Source="avares://AGBStudio/Theme/Panels.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource bg/base}" />
    <Setter Property="Foreground" Value="{DynamicResource text/primary}" />
    <Setter Property="FontFamily" Value="{x:Static t:Fonts.Inter}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Popup">
    <Setter Property="ShouldUseOverlayLayer" Value="True" />
  </Style>
</Styles>
