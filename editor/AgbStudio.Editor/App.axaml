<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:AgbStudio.Editor.Controls"
             x:Class="AgbStudio.Editor.App"
             Name="AGB Studio"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceInclude x:Key="Dark" Source="avares://AGBStudio/Theme/Tokens.Dark.axaml" />
        <ResourceInclude x:Key="Light" Source="avares://AGBStudio/Theme/Tokens.Light.axaml" />
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.DataTemplates>
    <DataTemplate DataType="c:TipContent">
      <c:TooltipView Text="{Binding Text}" Shortcut="{Binding Shortcut}" />
    </DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AGBStudio/Theme/Controls.axaml" />
  </Application.Styles>
</Application>
