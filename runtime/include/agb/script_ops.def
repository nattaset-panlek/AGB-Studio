// Event Script VM opcodes: the single source for the runtime handlers and the C# bytecode compiler
// (tools/AgbStudio.Scripting reads this file). Format: AGB_OP(name, operand bytes, stack effect note).
// Operands are little-endian and follow the opcode byte.
AGB_OP(End, 0, "stop the context")
AGB_OP(Nop, 0, "")
AGB_OP(PushI8, 1, "push s8")
AGB_OP(PushI16, 2, "push s16")
AGB_OP(PushI32, 4, "push s32 (also fixed raw)")
AGB_OP(Pop, 0, "drop top")
AGB_OP(Dup, 0, "duplicate top")
AGB_OP(LoadLocal, 1, "push local[u8]")
AGB_OP(StoreLocal, 1, "pop into local[u8]")
AGB_OP(LoadVar, 2, "push var[u16]")
AGB_OP(StoreVar, 2, "pop into var[u16]")
AGB_OP(GetFlag, 2, "push flag[u16]")
AGB_OP(SetFlag, 2, "flag[u16] = pop != 0")
AGB_OP(Add, 0, "a + b")
AGB_OP(Sub, 0, "a - b")
AGB_OP(Mul, 0, "a * b (int)")
AGB_OP(Div, 0, "a / b (int)")
AGB_OP(Mod, 0, "a % b")
AGB_OP(FMul, 0, "a * b (24.8 fixed)")
AGB_OP(FDiv, 0, "a / b (24.8 fixed)")
AGB_OP(Neg, 0, "-a")
AGB_OP(Eq, 0, "a == b")
AGB_OP(Ne, 0, "a != b")
AGB_OP(Lt, 0, "a < b")
AGB_OP(Le, 0, "a <= b")
AGB_OP(Gt, 0, "a > b")
AGB_OP(Ge, 0, "a >= b")
AGB_OP(And, 0, "logical and")
AGB_OP(Or, 0, "logical or")
AGB_OP(Not, 0, "logical not")
AGB_OP(Jump, 2, "pc += s16")
AGB_OP(JumpIfFalse, 2, "pop; if 0 then pc += s16")
AGB_OP(JumpIfTrue, 2, "pop; if != 0 then pc += s16")
AGB_OP(Call, 2, "call script[u16]; arguments stay on the stack")
AGB_OP(Ret, 0, "return to caller; top of stack is the result")
AGB_OP(Native, 3, "call native[u16] with u8 arguments; pushes the result")
AGB_OP(WaitFrames, 0, "pop n; yield for n frames")
AGB_OP(Yield, 0, "yield until next frame")
AGB_OP(Line, 2, "source line marker for the debugger (u16 line)")
AGB_OP(WaitUntil, 2, "pop; if 0 then pc += s16 (back to the condition) and yield until next frame")
