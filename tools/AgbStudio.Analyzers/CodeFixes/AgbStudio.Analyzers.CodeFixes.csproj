<Project Sdk="Microsoft.NET.Sdk">
  <!-- Code fixes "Change to fixed" and "Ignore" for the GAE rules (Script Editor diagnostic popup, IDEs). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>AgbStudio.Analyzers.CodeFixes</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AgbStudio.Analyzers.csproj" />
  </ItemGroup>
</Project>
